############################################################################
# configure llvm toolchain
############################################################################
bazel_dep(name = "llvm", version = "0.8.6")

toolchain = use_extension("@llvm//extensions:toolchain.bzl", "toolchain")

llvm_source = use_extension("@llvm//extensions:llvm_source.bzl", "llvm_source")
# llvm_source.version(llvm_version = "23.0.0")

toolchain.exec(
    arch = "x86_64",
    os = "linux",
)
toolchain.exec(
    arch = "aarch64",
    os = "linux",
)
toolchain.target(
    arch = "x86_64",
    os = "linux",
)
toolchain.target(
    arch = "aarch64",
    os = "linux",
)
